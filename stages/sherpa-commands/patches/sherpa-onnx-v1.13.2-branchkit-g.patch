+namespace {
+
+// How many built structured grammars to keep: the full free-context grammar
+// plus the few modes a person moves between. Small modes cost little memory;
+// the full grammar dominates (its size is in the timing log).
+constexpr size_t kDagCacheEntries = 4;
+
+// The exact request a structured grammar is built from, as a cache key: two
+// requests with the same key build the same graph against the same lexicon.
+std::string DagCacheKey(const GrammarDag &dag,
+                        const std::vector<std::string> &union_words) {
+  std::ostringstream os;
+  os << dag.num_states << ' ' << dag.start << '\n';
+  for (size_t i = 0; i < dag.arc_word.size(); ++i) {
+    os << dag.arc_from[i] << ' ' << dag.arc_to[i] << ' ' << dag.arc_word[i];
+    if (i < dag.arc_weight.size()) os << ' ' << dag.arc_weight[i];
+    os << '\n';
+  }
+  for (size_t i = 0; i < dag.open_states.size(); ++i) {
+    os << "o " << dag.open_states[i];
+    if (i < dag.open_alphabets.size()) {
+      for (const auto &w : dag.open_alphabets[i]) os << ' ' << w;
+    }
+    os << '\n';
+  }
+  os << "u";
+  for (const auto &w : union_words) os << ' ' << w;
+  return os.str();
+}
+
+}  // namespace
+
+std::unique_ptr<fst::Fst<StdArc>> GrammarBuilder::BuildFromDagLazy(
+    const GrammarDag &dag, const std::vector<std::string> &union_words) const {
+  auto t_all = Clock::now();
+  std::string key = DagCacheKey(dag, union_words);
+
+  // The CURRENT request's word universe (union + DAG arc words, first-seen
+  // dedup). It feeds the lexicon grow AND bounds the unbounded open-state
+  // self-loops below: looping over the whole accumulated lexicon instead
+  // would silently widen an open tail to words the platform has since
+  // retired or narrowed away.
+  std::vector<std::string> universe;
+  {
+    std::unordered_map<std::string, int32_t> seen;
+    universe.reserve(union_words.size() + dag.arc_word.size());
+    for (const auto &w : union_words) {
+      if (seen.emplace(w, 1).second) universe.push_back(w);
+    }
+    for (const auto &w : dag.arc_word) {
+      if (seen.emplace(w, 1).second) universe.push_back(w);
+    }
+  }
+  bool hl_rebuilt = EnsureLazyHL(universe);
+  if (hl_rebuilt) {
+    dag_cache_.clear();
+  } else {
+    auto hit = std::find_if(dag_cache_.begin(), dag_cache_.end(),
+                            [&](const auto &e) { return e.first == key; });
+    if (hit != dag_cache_.end()) {
+      auto entry = *hit;
+      dag_cache_.erase(hit);
+      dag_cache_.insert(dag_cache_.begin(), entry);
+      if (verbose_) {
+        fprintf(stderr,
+                "[grammar-builder] BuildFromDagLazy(%d states, %zu arcs): "
+                "cached graph (%d states), %.2f ms total\n",
+                dag.num_states, dag.arc_word.size(), entry.second->NumStates(),
+                MsSince(t_all));
+      }
+      return std::make_unique<StdVectorFst>(*entry.second);
+    }
+  }
+
+  // G: the pattern-DAG as a word acceptor, arcs labeled with the lazy word2id
+  // (the ids the cached HL emits). One state per DAG state; the start state is
+  // also the sole base accept state — every command-final arc returns there.
+  // Per-arc weight rides straight on the arc (contextual bias). Open states
+  // (free text / dependent capture / unenumerable tails) become final with a
+  // self-loop over their bounded alphabet when the compiler supplied one, else
+  // over the request universe.
+  auto G = std::make_unique<StdVectorFst>();
+  for (int32_t i = 0; i < dag.num_states; ++i) G->AddState();
+  int32_t n_dropped = 0;
+  if (dag.num_states > 0 && dag.start >= 0 && dag.start < dag.num_states) {
+    G->SetStart(dag.start);
+    G->SetFinal(dag.start, StdArc::Weight::One());
+    for (size_t i = 0; i < dag.arc_word.size(); ++i) {
+      // Endpoint guard, mirroring the open_states check below: the D1
+      // compiler emits valid ids by construction, but an out-of-range id
+      // would index OpenFST's state vector out of bounds (release-mode heap
+      // corruption) — drop the arc instead, counted with the no-BPE drops.
+      if (dag.arc_from[i] < 0 || dag.arc_from[i] >= dag.num_states ||
+          dag.arc_to[i] < 0 || dag.arc_to[i] >= dag.num_states) {
+        ++n_dropped;
+        continue;
+      }
+      auto it = lazy_word2id_.find(dag.arc_word[i]);
+      if (it == lazy_word2id_.end()) {  // no BPE tokens -> dropped from HL
+        ++n_dropped;
+        continue;
+      }
+      int32_t wid = it->second;
+      float wcost = (i < dag.arc_weight.size()) ? dag.arc_weight[i] : 0.0f;
+      G->AddArc(dag.arc_from[i],
+                StdArc(wid, wid, StdArc::Weight(wcost), dag.arc_to[i]));
+    }
+    for (size_t oi = 0; oi < dag.open_states.size(); ++oi) {
+      int32_t s = dag.open_states[oi];
+      if (s < 0 || s >= dag.num_states) continue;
+      G->SetFinal(s, StdArc::Weight::One());
+      const std::vector<std::string> *alpha =
+          (oi < dag.open_alphabets.size() && !dag.open_alphabets[oi].empty())
+              ? &dag.open_alphabets[oi]
+              : nullptr;
+      const std::vector<std::string> &loop_words = alpha ? *alpha : universe;
+      for (const auto &w : loop_words) {
+        auto it = lazy_word2id_.find(w);
+        if (it == lazy_word2id_.end()) continue;
+        G->AddArc(s, StdArc(it->second, it->second, StdArc::Weight::One(), s));
+      }
+    }
+  }
+  // DISTINCT universe words that resolved in the lexicon — the same measure
+  // BuildLazy's `added` gives ComposeLazy.
+  size_t resolved = 0;
+  for (const auto &w : universe) {
+    if (lazy_word2id_.count(w)) ++resolved;
+  }
+  // Always trimmed: a pattern DAG admits only some words at each state, so
+  // its composition has dead ends even when the request covers the whole
+  // lexicon. Left to the subset test, the same DAG composed lazily in a fresh
+  // recognizer and trimmed in one whose lexicon had grown, and the two
+  // decoded the same off-grammar clip differently ("hello there": "" vs
+  // "HELLO BRANCHKIT", measured 2026-09-26). Trimming the full free-context
+  // DAG costs about 0.15 s per swap at ~1.9k words through the lookahead
+  // composition (ComposeTrimmed); expanding it all first took ~12 s.
+  bool narrow = false;
+  auto graph = ComposeLazy(std::move(G), resolved, true, &narrow);
+  // always_trim makes the result a materialized VectorFst.
+  int32_t graph_states = -1;
+  if (auto *built = dynamic_cast<StdVectorFst *>(graph.get())) {
+    graph_states = built->NumStates();
+    dag_cache_.insert(dag_cache_.begin(),
+                      {key, std::make_shared<StdVectorFst>(*built)});
+    if (dag_cache_.size() > kDagCacheEntries) dag_cache_.pop_back();
+  }
+
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] BuildFromDagLazy(%d states, %zu arcs, %zu words, "
+            "%d dropped): HL %s, %s (%d states), %.2f ms total\n",
+            dag.num_states, dag.arc_word.size(), universe.size(), n_dropped,
+            hl_rebuilt ? "REBUILT" : "cached",
+            narrow ? "trimmed (narrow)" : "lazy compose",
+            graph_states, MsSince(t_all));
+  }
+  return graph;
+}
