diff --git a/sherpa-onnx/csrc/interactive-threads.cc b/sherpa-onnx/csrc/interactive-threads.cc
new file mode 100644
index 0000000..907dedc
--- /dev/null
+++ b/sherpa-onnx/csrc/interactive-threads.cc
@@ -0,0 +1,105 @@
+// sherpa-onnx/csrc/interactive-threads.cc
+//
+// [BranchKit] See interactive-threads.h.
+
+#include "sherpa-onnx/csrc/interactive-threads.h"
+
+#include <atomic>
+#include <thread>  // NOLINT
+
+#if defined(__APPLE__)
+#include <pthread.h>
+#include <sys/qos.h>
+#elif defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace sherpa_onnx {
+
+namespace {
+
+std::atomic<bool> g_enabled{false};
+std::atomic<int32_t> g_created{0};
+std::atomic<int32_t> g_raised{0};
+
+constexpr bool kSupported =
+#if defined(__APPLE__) || defined(_WIN32)
+    true;
+#else
+    false;
+#endif
+
+// Whether the calling thread reads back at the raised level.
+bool CurrentThreadIsInteractive() {
+#if defined(__APPLE__)
+  qos_class_t qos = QOS_CLASS_UNSPECIFIED;
+  int relative = 0;
+  if (pthread_get_qos_class_np(pthread_self(), &qos, &relative) != 0) {
+    return false;
+  }
+  return qos == QOS_CLASS_USER_INTERACTIVE;
+#elif defined(_WIN32)
+  return GetThreadPriority(GetCurrentThread()) >= THREAD_PRIORITY_ABOVE_NORMAL;
+#else
+  return false;
+#endif
+}
+
+OrtCustomThreadHandle CreateInteractiveThread(void * /*options*/,
+                                              OrtThreadWorkerFn worker,
+                                              void *param) {
+  auto *t = new std::thread([worker, param]() {
+    bool raised = RaiseCurrentThreadToInteractive();
+    g_created.fetch_add(1);
+    if (raised) g_raised.fetch_add(1);
+    worker(param);
+  });
+  return reinterpret_cast<OrtCustomThreadHandle>(t);
+}
+
+void JoinInteractiveThread(OrtCustomThreadHandle handle) {
+  auto *t = reinterpret_cast<std::thread *>(
+      const_cast<OrtCustomHandleType *>(handle));
+  if (t->joinable()) t->join();
+  delete t;
+}
+
+}  // namespace
+
+bool SetInteractiveOrtThreads(bool enabled) {
+  if (!kSupported) return false;
+  g_enabled.store(enabled);
+  return true;
+}
+
+void ApplyInteractiveThreads(Ort::SessionOptions *opts) {
+  if (!kSupported || !g_enabled.load()) return;
+  opts->SetCustomCreateThreadFn(CreateInteractiveThread);
+  opts->SetCustomJoinThreadFn(JoinInteractiveThread);
+}
+
+bool RaiseCurrentThreadToInteractive() {
+#if defined(__APPLE__)
+  if (pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0) != 0) {
+    return false;
+  }
+#elif defined(_WIN32)
+  // ABOVE_NORMAL, not HIGHEST: onnxruntime's workers spin briefly between
+  // bursts, and a spinning thread above every UI thread on the machine is a
+  // worse trade than the one level this needs.
+  if (!SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL)) {
+    return false;
+  }
+#endif
+  return CurrentThreadIsInteractive();
+}
+
+void InteractiveOrtThreadStats(int32_t *created, int32_t *raised) {
+  if (created) *created = g_created.load();
+  if (raised) *raised = g_raised.load();
+}
+
+}  // namespace sherpa_onnx
diff --git a/sherpa-onnx/csrc/interactive-threads.h b/sherpa-onnx/csrc/interactive-threads.h
new file mode 100644
index 0000000..203abaa
--- /dev/null
+++ b/sherpa-onnx/csrc/interactive-threads.h
@@ -0,0 +1,46 @@
+// sherpa-onnx/csrc/interactive-threads.h
+//
+// [BranchKit] Run onnxruntime's worker threads at the OS's interactive
+// priority. A command recognizer's encode is a short burst a person is
+// waiting on, and at default priority it queues behind whatever else the
+// machine is doing (measured: encode p90 350 ms on 1-2 word phrases while
+// other work ran). Raising the process's main thread does not reach the
+// encoder: onnxruntime runs it on intra-op threads it creates itself, and a
+// thread does not inherit its creator's QoS on macOS (probed: a thread made
+// by a QOS_CLASS_USER_INTERACTIVE thread comes up at QOS_CLASS_DEFAULT). So
+// the raise happens inside onnxruntime's thread-creation hook, on every
+// worker it creates.
+//
+// macOS: QOS_CLASS_USER_INTERACTIVE. Windows: THREAD_PRIORITY_ABOVE_NORMAL.
+// Linux: nothing (no unprivileged raise above the default nice level); the
+// switch reports unsupported and no hook is installed.
+
+#ifndef SHERPA_ONNX_CSRC_INTERACTIVE_THREADS_H_
+#define SHERPA_ONNX_CSRC_INTERACTIVE_THREADS_H_
+
+#include <cstdint>
+
+#include "onnxruntime_cxx_api.h"  // NOLINT
+
+namespace sherpa_onnx {
+
+// Process-wide switch, off by default (upstream behavior). Applies to
+// sessions created after the call. Returns false where the OS has no
+// supported raise (the switch then stays off).
+bool SetInteractiveOrtThreads(bool enabled);
+
+// Install the thread-creation hooks on `opts` when the switch is on.
+void ApplyInteractiveThreads(Ort::SessionOptions *opts);
+
+// Raise the calling thread. The thread that calls Decode also runs part of
+// every encode (onnxruntime's caller thread joins its intra-op pool), so it
+// needs the same raise as the workers. Returns true when the raise took.
+bool RaiseCurrentThreadToInteractive();
+
+// How many worker threads the hook created, and how many of those read back
+// as raised from inside the thread itself.
+void InteractiveOrtThreadStats(int32_t *created, int32_t *raised);
+
+}  // namespace sherpa_onnx
+
+#endif  // SHERPA_ONNX_CSRC_INTERACTIVE_THREADS_H_
