+// [BranchKit command-grammar compiler — D2] A word-level DAG describing the
+// allowed command word-sequences, compiled in the actuator (Phase D1) from
+// every plugin's cmd.pattern. Carried over the C-API as parallel arrays.
+// `start` is the start AND sole base accept state (0); every command-final arc
+// returns there. `open_states` are states whose continuation could not be
+// enumerated (free text / dependent capture / list repeat-optional) — the
+// builder realizes each as final + a self-loop over the whole word alphabet.
+struct GrammarDag {
+  int32_t num_states = 0;
+  int32_t start = 0;
+  std::vector<int32_t> arc_from;
+  std::vector<std::string> arc_word;
+  std::vector<int32_t> arc_to;
+  std::vector<float> arc_weight;  // empty, or parallel to the arc arrays
+  std::vector<int32_t> open_states;
+  // [BranchKit narrowing] Per-open-state bounded self-loop alphabet, parallel to
+  // `open_states`. An empty inner vector (or a short/absent outer vector) means
+  // "unbounded" — loop over the whole word alphabet, the original behavior.
+  // A non-empty set restricts that state's self-loop to just those words.
+  std::vector<std::vector<std::string>> open_alphabets;
+};
