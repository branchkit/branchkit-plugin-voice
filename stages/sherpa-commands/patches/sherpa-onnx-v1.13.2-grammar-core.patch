+// sherpa-onnx/csrc/grammar-builder.cc
+//
+// [BranchKit Direction 2] In-process HL grammar builder. See header.
+
+#include "sherpa-onnx/csrc/grammar-builder.h"
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>  // NOLINT
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <unordered_map>
+#include <utility>
+
+#include "kaldifst/csrc/determinize-star.h"
+#include "sherpa-onnx/csrc/macros.h"
+#include "ssentencepiece/csrc/ssentencepiece.h"
+
+namespace sherpa_onnx {
+
+using fst::StdArc;
+using StdVectorFst = fst::VectorFst<StdArc>;
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+double MsSince(const Clock::time_point &t0) {
+  return std::chrono::duration<double, std::milli>(Clock::now() - t0).count();
+}
+
+bool IsDisambig(const std::string &tok) {
+  if (tok.size() < 2 || tok[0] != '#') return false;
+  for (size_t i = 1; i < tok.size(); ++i) {
+    if (!std::isdigit(static_cast<unsigned char>(tok[i]))) return false;
+  }
+  return true;
+}
+
+// build_standard_ctc_topo: a fully-connected CTC topology. State i has, for every
+// token k, an arc (ilabel=k, olabel=0 on self-loops + arcs entering blank, else k;
+// blank_id = the model's real blank, zipformer 0 / NeMo 1024). Vocab-independent.
+std::unique_ptr<StdVectorFst> BuildStandardCtcTopo(int32_t max_token_id, int32_t blank_id) {
+  int32_t num_states = max_token_id + 1;
+  auto f = std::make_unique<StdVectorFst>();
+  for (int32_t i = 0; i < num_states; ++i) {
+    int32_t s = f->AddState();
+    f->SetFinal(s, StdArc::Weight::One());
+  }
+  f->SetStart(blank_id);
+  for (int32_t i = 0; i < num_states; ++i) {
+    for (int32_t k = 0; k < num_states; ++k) {
+      int32_t olabel = (i == k || k == blank_id) ? 0 : k;
+      f->AddArc(i, StdArc(k, olabel, StdArc::Weight::One(), k));
+    }
+  }
+  return f;
+}
+
+// add_one: shift labels by +1 (OpenFST reserves ilabel 0 = epsilon, but the CTC
+// topo's token id 0 = blank is a real symbol). For H: shift every ilabel and
+// every non-zero olabel. For L: shift every ilabel only.
+void AddOne(StdVectorFst *f, bool update_olabel) {
+  for (fst::StateIterator<StdVectorFst> sit(*f); !sit.Done(); sit.Next()) {
+    int32_t state = sit.Value();
+    for (fst::MutableArcIterator<StdVectorFst> ait(f, state); !ait.Done();
+         ait.Next()) {
+      StdArc arc = ait.Value();
+      arc.ilabel += 1;
+      if (update_olabel && arc.olabel != 0) arc.olabel += 1;
+      ait.SetValue(arc);
+    }
+  }
+}
+
+// add_disambig_self_loops: for every state, add a self-loop for each disambig
+// symbol id in [start, end].
+void AddDisambigSelfLoops(StdVectorFst *f, int32_t start, int32_t end) {
+  for (fst::StateIterator<StdVectorFst> sit(*f); !sit.Done(); sit.Next()) {
+    int32_t state = sit.Value();
+    for (int32_t i = start; i <= end; ++i) {
+      f->AddArc(state, StdArc(i, i, StdArc::Weight::One(), state));
+    }
+  }
+}
+
+// make_lexicon_fst_no_silence: a single looping state; each word is a path of
+// arcs from the loop state back to it, emitting the word id on the first arc.
+std::unique_ptr<StdVectorFst> MakeLexiconFstNoSilence(
+    const std::vector<std::pair<std::string, std::vector<std::string>>> &lexicon,
+    const std::unordered_map<std::string, int32_t> &token2id,
+    const std::unordered_map<std::string, int32_t> &word2id) {
+  auto f = std::make_unique<StdVectorFst>();
+  int32_t start = f->AddState();
+  f->SetStart(start);
+  f->SetFinal(start, StdArc::Weight::One());
+
+  for (const auto &entry : lexicon) {
+    const std::string &word = entry.first;
+    const std::vector<std::string> &phoneseq = entry.second;
+    int32_t wid = word2id.at(word);
+    int32_t cur = start;
+    int32_t n = static_cast<int32_t>(phoneseq.size());
+
+    for (int32_t i = 0; i < n - 1; ++i) {
+      int32_t next = f->AddState();
+      int32_t olabel = (i == 0) ? wid : 0;
+      f->AddArc(cur, StdArc(token2id.at(phoneseq[i]), olabel,
+                            StdArc::Weight::One(), next));
+      cur = next;
+    }
+
+    int32_t i = n - 1;  // -1 if phoneseq empty
+    int32_t ilabel = (i >= 0) ? token2id.at(phoneseq[i]) : 0;
+    int32_t olabel = (i <= 0) ? wid : 0;
+    f->AddArc(cur, StdArc(ilabel, olabel, StdArc::Weight::One(), start));
+  }
+  return f;
+}
+
+// add_lex_disambig.pl port: append #N disambig symbols to homophone /
+// prefix-colliding pronunciations so the lexicon FST is determinizable.
+// Returns the disambiguated lexicon and the max disambig index used.
+std::pair<std::vector<std::pair<std::string, std::vector<std::string>>>, int32_t>
+AddDisambigSymbols(
+    const std::vector<std::pair<std::string, std::vector<std::string>>>
+        &lexicon) {
+  auto join = [](const std::vector<std::string> &v) {
+    std::string s;
+    for (size_t i = 0; i < v.size(); ++i) {
+      if (i) s += ' ';
+      s += v[i];
+    }
+    return s;
+  };
+
+  std::unordered_map<std::string, int32_t> count;
+  for (const auto &e : lexicon) count[join(e.second)] += 1;
+
+  std::unordered_map<std::string, int32_t> issubseq;
+  for (const auto &e : lexicon) {
+    std::vector<std::string> toks = e.second;
+    if (!toks.empty()) toks.pop_back();
+    while (!toks.empty()) {
+      issubseq[join(toks)] = 1;
+      toks.pop_back();
+    }
+  }
+
+  std::vector<std::pair<std::string, std::vector<std::string>>> ans;
+  const int32_t first_allowed = 1;
+  int32_t max_disambig = first_allowed - 1;
+  std::unordered_map<std::string, int32_t> last_used;
+
+  for (const auto &e : lexicon) {
+    std::string key = join(e.second);
+    if (issubseq[key] == 0 && count[key] == 1) {
+      ans.push_back(e);
+      continue;
+    }
+    int32_t cur = last_used.count(key) ? last_used[key] : 0;
+    cur = (cur == 0) ? first_allowed : cur + 1;
+    if (cur > max_disambig) max_disambig = cur;
+    last_used[key] = cur;
+    std::vector<std::string> toks = e.second;
+    toks.push_back("#" + std::to_string(cur));
+    ans.emplace_back(e.first, std::move(toks));
+  }
+  return {ans, max_disambig};
+}
+
+}  // namespace
+
+GrammarBuilder::GrammarBuilder(const std::string &tokens_txt,
+                               const std::string &lexicon_txt,
+                               const std::string &bpe_vocab) {
+  verbose_ = std::getenv("BK_GRAMMAR_TIMING") != nullptr;
+
+  // tokens.txt -> token2id; record #0 id, max disambig id, max id.
+  {
+    std::ifstream is(tokens_txt);
+    if (!is) {
+      SHERPA_ONNX_LOGE("GrammarBuilder: cannot open tokens %s",
+                       tokens_txt.c_str());
+    }
+    std::string tok;
+    int32_t id;
+    while (is >> tok >> id) {
+      token2id_[tok] = id;
+      if (id > max_id_) max_id_ = id;
+      if (IsDisambig(tok)) {
+        if (id > model_max_disambig_id_) model_max_disambig_id_ = id;
+      }
+    }
+  }
+
+  // lexicon.txt -> word -> tokens (first pronunciation wins).
+  if (!lexicon_txt.empty()) {
+    std::ifstream is(lexicon_txt);
+    std::string line;
+    while (std::getline(is, line)) {
+      std::istringstream iss(line);
+      std::string word, t;
+      if (!(iss >> word)) continue;
+      if (model_lexicon_.count(word)) continue;
+      std::vector<std::string> toks;
+      while (iss >> t) toks.push_back(t);
+      if (!toks.empty()) model_lexicon_[word] = std::move(toks);
+    }
+  }
+
+  if (!bpe_vocab.empty()) {
+    std::ifstream test(bpe_vocab);
+    if (test) {
+      bpe_ = std::make_unique<ssentencepiece::Ssentencepiece>(bpe_vocab);
+    }
+  }
+
+  // Build + cache the vocab-independent CTC topo. max_token_id excludes
+  // disambig symbols and 0 -> it's the max real BPE token id.
+  int32_t max_token_id = 0;
+  for (const auto &kv : token2id_) {
+    if (kv.second != 0 && !IsDisambig(kv.first) && kv.second > max_token_id) {
+      max_token_id = kv.second;
+    }
+  }
+
+  auto t0 = Clock::now();
+  base_H_ = BuildStandardCtcTopo(max_token_id, token2id_.count("<blk>") ? token2id_.at("<blk>") : 0);
+  AddOne(base_H_.get(), /*update_olabel=*/true);
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] H ctc topo (cached, vocab-independent): "
+            "max_token_id=%d, %d states, built in %.1f ms\n",
+            max_token_id, base_H_->NumStates(), MsSince(t0));
+  }
+}
+
+GrammarBuilder::~GrammarBuilder() = default;
+
+std::vector<std::string> GrammarBuilder::WordToTokens(
+    const std::string &word) const {
+  auto it = model_lexicon_.find(word);
+  if (it != model_lexicon_.end()) return it->second;
+  std::vector<std::string> toks;
+  if (bpe_) bpe_->Encode(word, &toks);
+  return toks;
+}
+
+std::unique_ptr<StdVectorFst> GrammarBuilder::BuildHL(
+    const std::vector<std::string> &words,
+    std::unordered_map<std::string, int32_t> *word2id_out) const {
+  auto t_all = Clock::now();
+  double t_lex = 0, t_disambig = 0, t_Lfst = 0, t_Hprep = 0, t_compose = 0,
+         t_det = 0, t_strip = 0;
+  int32_t n_via_bpe = 0;
+
+  // 1) word -> BPE tokens. Dedup words preserving order (words.txt has each
+  //    word once and word ids must be stable).
+  auto t = Clock::now();
+  std::vector<std::string> vocab;
+  std::unordered_map<std::string, int32_t> word2id;
+  std::vector<std::pair<std::string, std::vector<std::string>>> lexicon;
+  for (const auto &w : words) {
+    if (word2id.count(w)) continue;
+    auto toks = WordToTokens(w);
+    if (toks.empty()) {
+      SHERPA_ONNX_LOGE("GrammarBuilder: no tokens for word '%s' (skipped)",
+                       w.c_str());
+      continue;
+    }
+    if (!model_lexicon_.count(w)) ++n_via_bpe;
+    word2id[w] = static_cast<int32_t>(vocab.size()) + 1;  // 1..N
+    vocab.push_back(w);
+    lexicon.emplace_back(w, std::move(toks));
+  }
+  t_lex = MsSince(t);
+
+  // 2) disambig symbols.
+  t = Clock::now();
+  auto disambig_result = AddDisambigSymbols(lexicon);
+  auto &disambig_lex = disambig_result.first;
+  int32_t max_disambig = disambig_result.second;
+
+  // token2id including any disambig symbols our vocab needs beyond the model's.
+  std::unordered_map<std::string, int32_t> token2id = token2id_;
+  int32_t max_disambig_id = model_max_disambig_id_;
+  int32_t next_id = max_id_ + 1;
+  for (int32_t d = 0; d <= max_disambig; ++d) {
+    std::string sym = "#" + std::to_string(d);
+    if (!token2id.count(sym)) {
+      token2id[sym] = next_id++;
+    }
+    if (token2id[sym] > max_disambig_id) max_disambig_id = token2id[sym];
+  }
+  t_disambig = MsSince(t);
+
+  // 3) L looping lexicon (+1 shift, olabel unchanged).
+  t = Clock::now();
+  auto L = MakeLexiconFstNoSilence(disambig_lex, token2id, word2id);
+  AddOne(L.get(), /*update_olabel=*/false);
+  t_Lfst = MsSince(t);
+
+  // 4) H prep: derive from base_H_ — copy, add disambig self-loops, olabel
+  //    arcsort. Rebuilt per call, uncached: BuildHL runs only when the
+  //    accumulated lexicon grows (EnsureLazyHL), never per swap, so there is
+  //    no repeated preparation to amortize (the eager path's only-grow
+  //    prepared-H cache — swap-cost C2 — is retired by construction). The
+  //    shift is +1 (H had add_one). disambig0 = the LOCAL #0 id (NeMo ships
+  //    no model #0).
+  t = Clock::now();
+  int32_t shift_d0 = token2id.at("#0") + 1;
+  int32_t shift_dmax = max_disambig_id + 1;
+  auto prepared_H = std::make_unique<StdVectorFst>(*base_H_);
+  AddDisambigSelfLoops(prepared_H.get(), shift_d0, shift_dmax);
+  fst::ArcSort(prepared_H.get(), fst::OLabelCompare<StdArc>());
+  fst::ArcSort(L.get(), fst::ILabelCompare<StdArc>());
+  t_Hprep = MsSince(t);
+
+  // 5) compose H o L.
+  t = Clock::now();
+  auto HL = std::make_unique<StdVectorFst>();
+  fst::Compose(*prepared_H, *L, HL.get());
+  t_compose = MsSince(t);
+
+  // 6) determinize_star (epsilon-removing determinization).
+  t = Clock::now();
+  auto HL_det = std::make_unique<StdVectorFst>();
+  fst::DeterminizeStar(*HL, HL_det.get());
+  t_det = MsSince(t);
+
+  // 7) strip disambig: shifted disambig ilabels -> epsilon (0).
+  t = Clock::now();
+  for (fst::StateIterator<StdVectorFst> sit(*HL_det); !sit.Done(); sit.Next()) {
+    int32_t state = sit.Value();
+    for (fst::MutableArcIterator<StdVectorFst> ait(HL_det.get(), state);
+         !ait.Done(); ait.Next()) {
+      StdArc arc = ait.Value();
+      if (arc.ilabel >= shift_d0 && arc.ilabel <= shift_dmax) {
+        arc.ilabel = 0;
+        ait.SetValue(arc);
+      }
+    }
+  }
+  t_strip = MsSince(t);
+
+  if (word2id_out) *word2id_out = word2id;
+
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] BuildHL(%zu words, %d via bpe): HL %d states, "
+            "%.1f ms total\n"
+            "    %6.2f ms  word->bpe lexicon\n"
+            "    %6.2f ms  disambig symbols\n"
+            "    %6.2f ms  L looping fst\n"
+            "    %6.2f ms  H copy + disambig loops + arcsort\n"
+            "    %6.2f ms  compose H o L\n"
+            "    %6.2f ms  determinize_star\n"
+            "    %6.2f ms  strip disambig\n",
+            vocab.size(), n_via_bpe, HL_det->NumStates(), MsSince(t_all), t_lex,
+            t_disambig, t_Lfst, t_Hprep, t_compose, t_det, t_strip);
+  }
+
+  return HL_det;
+}
+
+// ---------------------------------------------------------------------------
+// [BranchKit lazy composition — the DEFAULT grammar path]
+// HL compiled once per lexicon, G built
+// from the swap payload in microseconds, fst::ComposeFst joins them on demand
+// during decoding. This is the ONLY grammar path — the recognizer impl
+// (offline-recognizer-ctc-impl.h) routes every swap here.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+// Cache budget for each delayed ComposeFst's expanded-state cache. Expanded
+// states accumulate across decodes within one grammar epoch (the cache lives
+// as long as the graph, i.e. until the next swap replaces the decoder); the
+// GC bound caps growth on long single-grammar sessions.
+constexpr size_t kLazyComposeCacheLimit = 64 << 20;
+
+// A narrow request's lazy graph is materialized and fst::Connect'd instead
+// of left delayed. The delayed composition of a wide HL with a NARROW G
+// keeps non-coaccessible dead ends — token prefixes of superset-lexicon
+// words that can never emit a G-admitted olabel. Those dead ends transiently
+// occupy the decoding beam and can prune the blank hypothesis, turning an
+// off-grammar utterance's intended empty decode into a forced in-mode word
+// (measured: "air air" under a snap narrow decoded ESCAPE lazily vs ""
+// eagerly; shield still held — only in-mode words are producible — but the
+// empty-decode-on-off-grammar property broke). Connect removes exactly those
+// states, restoring eager-equivalent search. The rule is subset-driven, NOT
+// count-capped: the trim is a correctness property and must hold for every
+// modal narrow regardless of size — slot-driven modes (open_app, key_mode)
+// can exceed any fixed cap. Only the full-union request — where delaying
+// pays and G admits the whole lexicon, so dead ends are marginal — stays
+// delayed.
+//
+// How the trim is computed (GrammarBuilder::ComposeTrimmed). Expanding the
+// plain composition first and then calling Connect explores every dead-end
+// prefix before discarding it: at a ~1.9k-word structured grammar that was
+// 13.2M states and 44.5M arcs expanded (9.3 s) and Connect (2.1 s) kept
+// 86,625, measured 2026-10-20. Composing through TrimLookAheadFst instead,
+// the lookahead filter refuses an HL arc whose reachable output labels match
+// no arc at G's current state, so a dead-end prefix is never entered: the
+// same composition expanded to 86,625 states in ~0.15 s and the final
+// Connect removed none. Nothing is pushed (see TrimLookAheadFst), so the
+// graph searched is the same one; decodes of 69 clips under the full grammar
+// and 966 across the 14 live mode grammars were identical in text, tokens,
+// timestamps and margins.
+
+}  // namespace
+
+std::unique_ptr<StdVectorFst> GrammarBuilder::ComposeTrimmed(
+    std::unique_ptr<StdVectorFst> G) const {
+  auto t0 = Clock::now();
+  // Lookahead sees one word ahead, never where a word arc leads, so a G state
+  // with no way to accept (an arc dropped for a word with no tokens) is
+  // removed here rather than left to strand a word in the beam.
+  fst::Connect(G.get());
+  const bool lookahead =
+      lazy_la_HL_ &&
+      fst::LookAheadMatchType<StdArc>(
+          static_cast<const fst::Fst<StdArc> &>(*lazy_la_HL_),
+          static_cast<const fst::Fst<StdArc> &>(*G)) == fst::MATCH_OUTPUT;
+  std::unique_ptr<StdVectorFst> out;
+  if (lookahead) {
+    // G's input labels move into the lookahead HL's relabeled output space;
+    // its output labels stay the word ids the decoder reads.
+    fst::LabelLookAheadRelabeler<StdArc>::Relabel(G.get(), *lazy_la_HL_, true);
+    fst::ArcSort(G.get(), fst::ILabelCompare<StdArc>());
+    out = std::make_unique<StdVectorFst>(fst::ComposeFst<StdArc>(
+        *lazy_la_HL_, *G, fst::CacheOptions(true, kLazyComposeCacheLimit)));
+  } else {
+    // Without lookahead the composition would be plain and keep every dead
+    // end; expand it all, as before lookahead, so the result is the same.
+    fprintf(stderr,
+            "[grammar-builder] WARNING: lookahead unavailable, trimming by "
+            "full expansion (slow)\n");
+    fst::ArcSort(G.get(), fst::ILabelCompare<StdArc>());
+    out = std::make_unique<StdVectorFst>(fst::ComposeFst<StdArc>(
+        *lazy_HL_, *G, fst::CacheOptions(true, kLazyComposeCacheLimit)));
+  }
+  const int32_t expanded = out->NumStates();
+  fst::Connect(out.get());
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] trim (%s): %d states expanded, Connect removed "
+            "%d, %.1f ms\n",
+            lookahead ? "lookahead" : "full expansion", expanded,
+            expanded - out->NumStates(), MsSince(t0));
+  }
+  return out;
+}
+
+bool GrammarBuilder::EnsureLazyHL(const std::vector<std::string> &words) const {
+  size_t before = lazy_vocab_.size();
+  for (const auto &w : words) {
+    if (lazy_seen_.emplace(w, 1).second) lazy_vocab_.push_back(w);
+  }
+  if (lazy_HL_ && lazy_vocab_.size() == before) return false;  // pure hit
+
+  // Miss or grow: re-derive HL over the whole accumulated lexicon. A word with
+  // no BPE tokens stays in lazy_vocab_ but is skipped (and logged) by BuildHL
+  // on every rebuild, so it consistently never gets an output-label id.
+  auto t0 = Clock::now();
+  lazy_word2id_.clear();
+  auto hl = BuildHL(lazy_vocab_, &lazy_word2id_);
+  // olabel-sorted ONCE here so every subsequent lazy compose can match against
+  // an ilabel-sorted G without per-swap sorting of the big side.
+  fst::ArcSort(hl.get(), fst::OLabelCompare<StdArc>());
+  lazy_HL_ = std::move(hl);
+  lazy_la_HL_ = std::make_shared<TrimLookAheadFst>(*lazy_HL_);
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] lazy HL rebuilt: %zu lexicon words (+%zu new), "
+            "%d states, %.1f ms\n",
+            lazy_vocab_.size(), lazy_vocab_.size() - before,
+            lazy_HL_->NumStates(), MsSince(t0));
+  }
+  return true;
+}
+
+std::unique_ptr<fst::Fst<StdArc>> GrammarBuilder::ComposeLazy(
+    std::unique_ptr<StdVectorFst> G, size_t resolved_words, bool always_trim,
+    bool *narrow_out) const {
+  // Narrow = the request resolves to a PROPER subset of the accumulated
+  // lexicon -> the trimmed composition (the dead-end trim; see the comment on
+  // ComposeTrimmed). resolved_words must count DISTINCT words that made
+  // it into lazy_word2id_ -- never raw request counts, which no-BPE words
+  // inflate (a miscount here skips the trim and reopens the
+  // empty-decode-on-off-grammar hole). Note the comparison is against the
+  // only-grow ACCUMULATED lexicon by design: if the platform's union itself
+  // shrinks (plugin disabled, command set rebuilt smaller), later full-union
+  // requests ARE proper subsets and correctly materialize -- the retired
+  // words' dead-end prefixes are exactly the beam hazard the trim removes.
+  // That costs a trimmed composition per swap (about 0.15 s at ~1.9k words,
+  // see ComposeTrimmed) instead of sub-ms until the process restarts;
+  // correctness over the cost claim.
+  //
+  // `always_trim` is for a G that does not admit every lexicon word at every
+  // state (a structured grammar): its composition has dead ends whatever the
+  // lexicon holds, so the subset test would make the search depend on which
+  // words earlier swaps happened to add -- two recognizers with the same
+  // request decoding the same audio differently.
+  const bool narrow = always_trim || resolved_words < lazy_word2id_.size();
+  if (narrow_out) *narrow_out = narrow;
+  if (narrow) return ComposeTrimmed(std::move(G));
+  fst::ArcSort(G.get(), fst::ILabelCompare<StdArc>());
+  return std::make_unique<fst::ComposeFst<StdArc>>(
+      *lazy_HL_, *G, fst::CacheOptions(true, kLazyComposeCacheLimit));
+}
+
+std::unique_ptr<fst::Fst<StdArc>> GrammarBuilder::BuildLazy(
+    const std::vector<std::string> &words,
+    const std::vector<float> &weights) const {
+  auto t_all = Clock::now();
+  bool hl_rebuilt = EnsureLazyHL(words);
+
+  // per-word bias: per-word, first-seen id, last non-zero weight wins, 0 =
+  // neutral. The bias rides the word's single G arc — composition ADDS
+  // weights (tropical), and a path emits the olabel exactly once per word
+  // occurrence, so the total path cost equals stamping every HL arc carrying
+  // the word's olabel (what the retired eager path did).
+  std::unordered_map<int32_t, float> bias_by_id;
+  size_t n = std::min(words.size(), weights.size());
+  for (size_t i = 0; i < n; ++i) {
+    if (weights[i] == 0.0f) continue;
+    auto it = lazy_word2id_.find(words[i]);
+    if (it != lazy_word2id_.end()) bias_by_id[it->second] = weights[i];
+  }
+
+  // G: a single-state unigram loop over the REQUESTED words only (not the
+  // accumulated lexicon) — the narrow lives entirely in G. Epsilon-free by
+  // construction, which is what keeps the default compose filter correct: only
+  // HL's output side carries epsilons.
+  auto G = std::make_unique<StdVectorFst>();
+  int32_t s = G->AddState();
+  G->SetStart(s);
+  G->SetFinal(s, StdArc::Weight::One());
+  std::unordered_map<int32_t, int32_t> added;
+  for (const auto &w : words) {
+    auto it = lazy_word2id_.find(w);
+    if (it == lazy_word2id_.end()) continue;  // no BPE tokens -> not in HL
+    int32_t wid = it->second;
+    if (!added.emplace(wid, 1).second) continue;
+    auto bit = bias_by_id.find(wid);
+    float wcost = (bit != bias_by_id.end()) ? bit->second : 0.0f;
+    G->AddArc(s, StdArc(wid, wid, StdArc::Weight(wcost), s));
+  }
+  bool narrow = false;
+  auto graph = ComposeLazy(std::move(G), added.size(), false, &narrow);
+
+  if (verbose_) {
+    fprintf(stderr,
+            "[grammar-builder] BuildLazy(%zu words): HL %s, G 1st/%zuarc, "
+            "%s, %.2f ms total\n",
+            words.size(), hl_rebuilt ? "REBUILT" : "cached", added.size(),
+            narrow ? "trimmed (narrow)" : "lazy compose",
+            MsSince(t_all));
+  }
+  return graph;
+}
+
+}  // namespace sherpa_onnx
