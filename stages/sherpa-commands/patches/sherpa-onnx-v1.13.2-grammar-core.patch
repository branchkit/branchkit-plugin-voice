+// sherpa-onnx/csrc/grammar-builder.h
+//
+// [BranchKit Direction 2] In-process HL grammar builder.
+//
+// Ports the offline icefall prepare_lang_fst flow (BranchKit's build_lang.py)
+// to C++ so the CTC decoding graph can be rebuilt from a word list at runtime
+// (runtime grammar-swap equivalent). Lazy composition throughout
+// ONE HL is derived per accumulated
+// lexicon (BuildHL via EnsureLazyHL, ~0.1 s at ~1.9k words, only when a
+// genuinely new word arrives); every swap builds only a tiny word-level G and joins it with
+// fst::ComposeFst on demand during decoding, so mode entry/exit and
+// weight/DAG changes cost microseconds-to-few-ms regardless of union size.
+
+#ifndef SHERPA_ONNX_CSRC_GRAMMAR_BUILDER_H_
+#define SHERPA_ONNX_CSRC_GRAMMAR_BUILDER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "fst/fstlib.h"
+
+namespace ssentencepiece {
+class Ssentencepiece;
+}
+
+namespace sherpa_onnx {
+
+// The cached HL in label-lookahead form, for ComposeTrimmed: one word of
+// output lookahead (epsilon and non-epsilon arcs), and nothing pushed. The
+// stock fst::StdOLabelLookAheadFst also pushes weights and labels, which
+// changes partial path costs and so the decoder's beam pruning; this keeps
+// the composition's arcs exactly HL∘G's.
+inline constexpr char kTrimLookAheadFstType[] = "branchkit_trim_lookahead";
+using TrimLookAheadFst = fst::MatcherFst<
+    fst::ConstFst<fst::StdArc>,
+    fst::LabelLookAheadMatcher<
+        fst::SortedMatcher<fst::ConstFst<fst::StdArc>>,
+        fst::kOutputLookAheadMatcher | fst::kLookAheadEpsilons |
+            fst::kLookAheadNonEpsilons,
+        fst::DefaultAccumulator<fst::StdArc>>,
+    kTrimLookAheadFstType, fst::LabelLookAheadRelabeler<fst::StdArc>>;
+
+class GrammarBuilder {
+ public:
+  // tokens_txt : the model's tokens.txt (token -> id, includes disambig #0..).
+  // lexicon_txt: word -> BPE token pronunciations (may be ""); preferred path.
+  // bpe_vocab  : simple-sentencepiece vocab (token<space>score per line, e.g.
+  //              bpe.vocab exported from the model's bpe.model) for words absent
+  //              from the lexicon (may be "").
+  GrammarBuilder(const std::string &tokens_txt, const std::string &lexicon_txt,
+                 const std::string &bpe_vocab);
+  ~GrammarBuilder();
+
+  // Build a word-loop grammar over `words` (flat unigram G over the cached
+  // lazy HL). `weights` (optional, parallel to `words`) sets a per-word
+  // decoding bias on the word's G arc — a weighted-WFST shallow-fusion prior
+  // (BranchKit's per-word bias). Empty = unweighted; per element 0 = neutral, positive
+  // penalizes the word, negative boosts it (bound boosts — large negatives
+  // make the word-loop run away into repetition). A request that is a proper
+  // subset of the accumulated lexicon is materialized + fst::Connect'd (the
+  // dead-end trim); the full-union request stays a delayed fst::ComposeFst.
+  // Returns the ABSTRACT fst::Fst — the decoder seam (OfflineCtcFstDecoder)
+  // takes it either way.
+  std::unique_ptr<fst::Fst<fst::StdArc>> BuildLazy(
+      const std::vector<std::string> &words,
+      const std::vector<float> &weights = {}) const;
+
+ private:
+  std::vector<std::string> WordToTokens(const std::string &word) const;
+
+  // The HL derivation (called by EnsureLazyHL on lexicon growth): word->BPE
+  // lexicon, disambig, looping L, compose H o L, determinize, strip disambig.
+  // Fills `*word2id_out` (word -> output-label id, 1..N, first-seen order) so
+  // the G builders label their arcs with the same ids HL emits.
+  std::unique_ptr<fst::VectorFst<fst::StdArc>> BuildHL(
+      const std::vector<std::string> &words,
+      std::unordered_map<std::string, int32_t> *word2id_out) const;
+
+  // Shared tail of the lazy builders: ilabel-sort G, join it with the cached
+  // HL via delayed ComposeFst, and materialize+Connect iff the request
+  // resolves to a proper subset of the accumulated lexicon (the dead-end
+  // trim) or `always_trim` is set. resolved_words = DISTINCT request words
+  // present in lazy_word2id_.
+  std::unique_ptr<fst::Fst<fst::StdArc>> ComposeLazy(
+      std::unique_ptr<fst::VectorFst<fst::StdArc>> G, size_t resolved_words,
+      bool always_trim, bool *narrow_out) const;
+
+  // The trimmed composition of the cached HL with `G`: HL∘G with every
+  // non-coaccessible state removed, as a VectorFst. Composed through
+  // lazy_la_HL_ so dead-end prefixes are never expanded (see the .cc).
+  std::unique_ptr<fst::VectorFst<fst::StdArc>> ComposeTrimmed(
+      std::unique_ptr<fst::VectorFst<fst::StdArc>> G) const;
+
+  std::unordered_map<std::string, int32_t> token2id_;
+  std::unordered_map<std::string, std::vector<std::string>> model_lexicon_;
+  std::unique_ptr<ssentencepiece::Ssentencepiece> bpe_;
+
+  int32_t model_max_disambig_id_ = -1;  // max disambig id shipped in tokens.txt
+  int32_t max_id_ = 0;                  // max id across all tokens.txt entries
+
+  // Cached vocab-independent CTC topo H (ctc topo + add_one). BuildHL derives
+  // its prepared H (disambig self-loops + arcsort) from this per call —
+  // BuildHL only runs on lexicon growth, so no prepared-H cache is needed.
+  std::unique_ptr<fst::VectorFst<fst::StdArc>> base_H_;
+
+  // Grow the accumulated lazy lexicon with `words` and (re)build the cached
+  // lazy HL if anything new arrived. Returns true on a rebuild (cache miss /
+  // grow), false on a pure hit.
+  bool EnsureLazyHL(const std::vector<std::string> &words) const;
+
+  // The persistent HL: built over
+  // `lazy_vocab_` (every word ever requested, first-seen order — only-grow, so
+  // a mode round-trip narrow<->wide never invalidates it), determinized,
+  // disambig-stripped, olabel-arcsorted for composition. `lazy_word2id_` is the
+  // matching word -> output-label map G's arcs must use. ComposeFst takes
+  // refcounted copies of its inputs, so replacing lazy_HL_ on a grow never
+  // invalidates a graph already handed to the decoder.
+  mutable std::vector<std::string> lazy_vocab_;
+  mutable std::unordered_map<std::string, int32_t> lazy_seen_;
+  mutable std::unordered_map<std::string, int32_t> lazy_word2id_;
+  mutable std::unique_ptr<fst::VectorFst<fst::StdArc>> lazy_HL_;
+  // lazy_HL_ in lookahead form, rebuilt with it (EnsureLazyHL). Read-only once
+  // built, and used only by the thread that builds grammars.
+  mutable std::shared_ptr<TrimLookAheadFst> lazy_la_HL_;
+
+  bool verbose_ = false;
+};
+
+}  // namespace sherpa_onnx
+
+#endif  // SHERPA_ONNX_CSRC_GRAMMAR_BUILDER_H_
