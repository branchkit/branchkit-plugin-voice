{
  "$schema": "https://branchkit.com/schemas/manifest.json",
  "id": "voice",
  "name": "Voice",
  "icon": "mic",
  "icon_color": "red",
  "requires": {
    "privileges": [
      "input",
      "dispatch",
      "microphone",
      "events.speech",
      "pipelines.speak_for_user",
      "questions.answer",
      "system.indicator",
      "notifications",
      "audio",
      "stage.neural_engine",
      "stage.gpu",
      "text.caret",
      "text.selection"
    ],
    "optional_privileges": ["calibration"],
    "capabilities": {
      "uses": [
        "hud.show",
        "indicator.set",
        "native.notify",
        "native.status_indicator"
      ]
    }
  },
  "version": "1.0.0",
  "min_api_version": "0.2.0",
  "description": "Core voice commands, phonetic alphabet, calibration, dictation timing.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "provides": {
    "collections": {
      "voice_commands": {
        "preset": "command_set",
        "description": "Voice command definitions contributed by all plugins."
      },
      "alphabet": {
        "id_strategy": {
          "type": "by_field",
          "field": "letter"
        },
        "preset": "named_entities",
        "fields": [
          {
            "key": "codeword",
            "field_type": "string",
            "label": "Codeword",
            "required": true
          },
          {
            "key": "letter",
            "field_type": "string",
            "label": "Letter",
            "required": true
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "codeword",
          "value_field": "letter"
        },
        "description": "Phonetic codewords and their assigned keys."
      },
      "number": {
        "id_strategy": {
          "type": "by_field",
          "field": "key"
        },
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken word"
          },
          {
            "key": "key",
            "field_type": "string",
            "label": "Value"
          },
          {
            "key": "aliases",
            "field_type": "string[]",
            "label": "Aliases"
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "key",
          "aliases_field": "aliases"
        },
        "description": "Spoken numbers (zero through ten)"
      },
      "direction": {
        "id_strategy": {
          "type": "by_field",
          "field": "key"
        },
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken word"
          },
          {
            "key": "key",
            "field_type": "string",
            "label": "Direction"
          },
          {
            "key": "aliases",
            "field_type": "string[]",
            "label": "Aliases"
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "key",
          "aliases_field": "aliases"
        },
        "description": "Directional words (up, down, left, right...)"
      },
      "plugin.voice.floatable_collections": {
        "id_strategy": {
          "type": "by_field",
          "field": "spoken"
        },
        "preset": "named_entities",
        "writers": "introducer_only",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name"
          },
          {
            "key": "collection",
            "field_type": "string",
            "label": "Collection id"
          }
        ],
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "collection"
        },
        "description": "Collections that can be floated as a reference card. Derived from the live entity collections at startup."
      },
      "plugin.voice.open_app": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Open-app picker — say an app name to switch to it."
      },
      "plugin.voice.collection_picker": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Open-collection picker — say a collection name to float it as a reference card."
      },
      "plugin.voice.key_mode": {
        "preset": "tag",
        "writers": "platform_only",
        "merge": "collect",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "clear_on_unrelated_command": true,
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Key-press mode — bare key names press keys with no prefix. Entered by 'key'; exits on release or 'over'."
      },
      "plugin.voice.mode": {
        "preset": "tag",
        "held_by_writer": false,
        "escape_exempt": true,
        "fields": [
          {
            "key": "name",
            "field_type": "string",
            "required": true
          }
        ],
        "feeds_matching": {
          "type": "as_gates",
          "name_field": "name"
        },
        "description": "Current voice input mode (idle, command hold, continuous, spelling)."
      },
      "plugin.voice.speaking": {
        "preset": "tag",
        "label": "Dictation is active",
        "fields": [],
        "description": "Active dictation session — text is being spoken for insertion."
      },
      "plugin.voice.tie_choices": {
        "id_strategy": {
          "type": "by_field",
          "field": "codeword"
        },
        "preset": "named_entities",
        "writers": "introducer_only",
        "fields": [
          {
            "key": "codeword",
            "field_type": "string",
            "label": "Codeword"
          },
          {
            "key": "pick",
            "field_type": "string",
            "label": "Choice value"
          },
          {
            "key": "aliases",
            "field_type": "string[]",
            "label": "Aliases"
          }
        ],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "codeword",
          "value_field": "pick",
          "aliases_field": "aliases"
        },
        "description": "Transient per-utterance disambiguation choices. Populated only while the user is choosing among tied commands; each entry maps a spoken codeword (and the candidate's app-name aliases) to a choice value. Cleared at the end of each input session."
      },
      "plugin.voice.disambiguating": {
        "preset": "tag",
        "writers": "introducer_only",
        "fields": [],
        "lifecycle": {
          "type": "clear_on_event",
          "events": [
            "_platform.input.session_boundary"
          ]
        },
        "exclusive": true,
        "feeds_matching": {
          "type": "as_gates",
          "scoped": true
        },
        "description": "Active command-tie disambiguation — the user is choosing among tied commands. Scoped + exclusive so only the transient choice grammar is live while it's set."
      },
      "plugin.voice.config": {
        "preset": "settings",
        "label": "Voice",
        "description": "Dictation and calibration settings. Defaults live here; only your changes are stored.",
        "fields": [
          {
            "key": "model",
            "label": "Dictation model",
            "description": "The Whisper model used for dictation. Change it on Get started, which shows what is downloaded.",
            "field_type": "string",
            "default": "openai_whisper-large-v3-v20240930"
          },
          {
            "key": "command_model",
            "label": "Command model",
            "description": "The model that hears voice commands: sherpa-offline-nemo (standard, most accurate) or sherpa-nemo-small (light: smaller and faster). Change it on Get started.",
            "field_type": "string",
            "default": "sherpa-offline-nemo"
          },
          {
            "key": "language",
            "label": "Dictation language",
            "description": "Language Whisper transcribes into.",
            "field_type": "string",
            "default": "en"
          },
          {
            "key": "command_language",
            "label": "Command language",
            "description": "Language the command engine listens for.",
            "field_type": "string",
            "default": "en-US"
          },
          {
            "key": "fix_all_caps",
            "label": "Fix ALL-CAPS dictation",
            "description": "Auto-correct when Whisper outputs entirely in UPPERCASE.",
            "field_type": "boolean",
            "default": true
          },
          {
            "key": "refine_dictation",
            "label": "Clean up with a local model",
            "description": "After a dictation, a language model on this computer removes false starts and self-corrections (\"Tuesday, no, Wednesday\" becomes \"Wednesday\"). Off by default: it adds a second or two, needs a 1.1 GB download, and its edits are only kept when they remove words, never when they add them. Say \"type original\" to get the unedited text back.",
            "field_type": "boolean",
            "default": false
          },
          {
            "key": "input_device",
            "label": "Microphone",
            "description": "The input device BranchKit listens through, for dictation and voice commands. Empty means the system default. Set from the Dictation tab.",
            "field_type": "string",
            "default": ""
          },
          {
            "key": "input_device_name",
            "label": "Microphone name",
            "description": "The chosen microphone's name, kept so it can be shown and matched while it is not connected.",
            "field_type": "string",
            "default": ""
          },
          {
            "key": "dictation_sounds",
            "label": "Start and stop sounds",
            "description": "A short sound when dictation starts listening and when it stops, so you know without looking.",
            "field_type": "boolean",
            "default": false
          },
          {
            "key": "dictation_enabled",
            "label": "Dictation",
            "description": "Hold the dictation key (Option+T on a Mac, Alt+T on Linux and Windows, unless you changed it) to dictate. Off means the dictation pipeline never starts.",
            "field_type": "boolean",
            "default": true
          },
          {
            "key": "voice_commands_enabled",
            "label": "Voice commands",
            "description": "Hold the command key (Option+G on a Mac, Alt+G on Linux and Windows, unless you changed it) to speak commands. Off means the command engine never starts.",
            "field_type": "boolean",
            "default": true
          },
          {
            "key": "calibration_capture",
            "label": "Capture calibration audio",
            "description": "While you calibrate, record your voice on-device to learn which words are hardest to recognize for you.",
            "field_type": "boolean",
            "default": true
          },
          {
            "key": "capture_retention",
            "label": "Calibration audio retention",
            "description": "How long calibration recordings are kept on disk, independent of whether they are ever analyzed.",
            "field_type": "enum",
            "enum_values": [
              "delete_after_analysis",
              "keep_bounded",
              "keep_all"
            ],
            "default": "keep_bounded"
          },
          {
            "key": "calibration_auto_advance",
            "label": "Auto-advance calibration",
            "description": "Move to the next calibration target as soon as the current one is heard correctly, with no Next click.",
            "field_type": "boolean",
            "default": false
          },
          {
            "key": "command_confidence_gate",
            "label": "Command confidence gate",
            "description": "What happens when a command's least certain word falls below the floor. Shadow only marks it in History and the log, so you can see what the gate would do; Enforce drops it instead of running it.",
            "field_type": "enum",
            "enum_values": ["off", "shadow", "enforce"],
            "default": "shadow"
          },
          {
            "key": "command_confidence_floor",
            "label": "Command confidence floor",
            "description": "The margin a command's least certain word must reach. Lower lets more through.",
            "field_type": "number",
            "default": -6
          }
        ]
      },
      "plugin.voice.app_profiles": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": {
          "type": "singleton"
        },
        "writers": "introducer_only",
        "description": "Per-app dictation profile overrides. Only your changes are stored; the shipped app table lives in the plugin so later releases can correct it."
      },
      "plugin.voice.app_styles": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": {
          "type": "singleton"
        },
        "writers": "introducer_only",
        "description": "Your dictation styles: the default for every app, and the apps that are exceptions to it (a style of their own, or none)."
      },
      "plugin.voice.corrections": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": {
          "type": "singleton"
        },
        "writers": "introducer_only",
        "description": "User-defined text correction rules for dictation post-processing."
      },
      "plugin.voice.dictation_vocabulary": {
        "preset": "data",
        "cardinality": "singleton",
        "id_strategy": {
          "type": "singleton"
        },
        "writers": "introducer_only",
        "description": "Words you use that dictation should spell your way: names, products, jargon. Biases the dictation decoder toward them; rewrites nothing."
      },
      "plugin.voice.hud_config": {
        "preset": "settings",
        "label": "HUD",
        "description": "HUD appearance settings. Defaults live here; only your changes are stored.",
        "fields": [
          {
            "key": "font_size",
            "label": "Font size",
            "field_type": "enum",
            "enum_values": [
              "small",
              "default",
              "large"
            ],
            "default": "default"
          },
          {
            "key": "show_badges",
            "label": "Show badges",
            "field_type": "boolean",
            "default": true
          },
          {
            "key": "compact_mode",
            "label": "Compact mode",
            "field_type": "boolean",
            "default": false
          },
          {
            "key": "opacity",
            "label": "Opacity",
            "field_type": "number",
            "default": 98
          },
          {
            "key": "blur_amount",
            "label": "Blur",
            "field_type": "int",
            "default": 40
          },
          {
            "key": "corner_radius",
            "label": "Corner radius",
            "field_type": "int",
            "default": 20
          },
          {
            "key": "disabled_channels",
            "label": "Disabled channels",
            "field_type": "object",
            "fields": [
              {
                "key": "main",
                "label": "Main disabled",
                "field_type": "boolean",
                "default": false
              },
              {
                "key": "discovery",
                "label": "Discovery disabled",
                "field_type": "boolean",
                "default": false
              },
              {
                "key": "notification",
                "label": "Notification disabled",
                "field_type": "boolean",
                "default": false
              }
            ]
          }
        ]
      },
      "plugin.voice.recognition_log": "collections/recognition_log.json",
      "plugin.voice.verification_attempts": "collections/verification_attempts.json",
      "plugin.voice.verification_sessions": "collections/verification_sessions.json",
      "plugin.voice.clip_fragility": "collections/clip_fragility.json",
      "plugin.voice.vocab_candidates": "collections/vocab_candidates.json",
      "plugin.voice.clip_bias_score": "collections/clip_bias_score.json"
    },
    "stages": {
      "vad_gate": {
        "stage_type": "vad_gate",
        "binary": "vad_gate"
      },
      "sherpa_commands": {
        "stage_type": "command_recognition",
        "binary": "sherpa_commands"
      },
      "whisperkit_stt": {
        "stage_type": "stt",
        "binary": "whisperkit_stage",
        "platform": "macos"
      },
      "refine_llm": {
        "stage_type": "request",
        "binary": "refine_llm"
      },
      "whisper_stt": {
        "stage_type": "stt",
        "binary": "whisper_stage",
        "platform": [
          "linux",
          "windows"
        ]
      }
    },
