          "_platform.model_info",
          "_platform.model_download",
          "_platform.bindings.active"
        ]
      },
      {
        "label": "Models",
        "key": "models",
        "reads": [
          "_platform.model_info",
          "_platform.model_download",
          "_platform.bindings.active"
        ]
      },
      {
        "label": "HUD",
        "key": "hud"
      }
    ],
    "setup_steps": [
      {
        "key": "start",
        "label": "Get started",
        "tab": "start",
        "required": true
      }
    ],
    "on_action": true,
    "render_settings": true,
    "on_commands_changed": true
  }
