  "consumes": {
    "writes": [
      "_platform.input",
      "_platform.pipelines"
    ],
    "effects": [
      {
        "asserts": [
          "suppress_keybinds"
        ],
        "user_visible_name": "Key Capture",
        "user_visible_description": "Pauses global hotkeys while the command editor records a keypress for an action, so the key you press is captured instead of triggering a command."
      }
    ],
    "collections": [
      {
        "name": "_platform.input",
        "fields": [
          "source"
        ]
      },
      {
        "name": "_platform.pipelines",
        "fields": [
          "name",
          "stages"
        ]
      },
      {
        "name": "alphabet",
        "seeds": [
          "_select_*"
        ]
      },
      {
        "name": "apps",
        "fields": [
          "spoken",
          "app_id",
          "name"
        ]
      },
      {
        "name": "app_traits",
        "fields": [
          "trait",
          "app_id"
        ]
      },
      {
        "name": "audio_inputs",
        "fields": [
          "spoken"
        ]
      },
      {
        "name": "audio_outputs",
        "fields": [
          "spoken"
        ]
      },
      {
        "name": "plugin.browser.tabs",
        "fields": [
          "spoken",
          "title"
        ]
      },
      {
        "name": "_platform.model_download"
      },
      {
        "name": "_platform.bindings.active"
      },
      {
        "name": "_platform.key_names",
        "fields": [
          "name",
          "code"
        ]
      },
      {
        "name": "keys",
        "fields": [
          "spoken",
          "key"
        ]
      },
      {
        "name": "modifiers",
        "fields": [
          "spoken",
          "key"
        ]
      }
    ],
    "events": [
      {
        "pattern": "_platform.collection.updated"
      },
      {
        "pattern": "_platform.app.focused"
      },
      {
        "pattern": "_platform.pipeline.transcript"
      },
      {
        "pattern": "_platform.pipeline.started"
      },
      {
        "pattern": "_platform.pipeline.stopped"
      },
      {
        "pattern": "_platform.pipeline.executed"
      },
      {
        "pattern": "_platform.pipeline.warming"
      },
      {
        "pattern": "_platform.pipeline.warmed"
      },
      {
        "pattern": "_platform.pipeline.error"
      },
      {
        "pattern": "_platform.permission.changed"
      }
    ]
  },
  "collection_data": {
    "voice_commands": "commands.json",
    "_platform.bindings": {
      "opt+t DOWN": {
        "action": "voice.dictation"
      },
      "opt+t UP": {
        "action": "voice.dictation"
      },
      "escape DOWN": {
        "action": "voice.dictation_cancel",
        "while": [
          "plugin.voice.mode.dictation"
        ]
      },
      "opt+g DOWN": {
        "action": "voice.command"
      },
      "opt+g UP": {
        "action": "voice.command"
      },
      "opt+c": {
        "action": "voice.continuous_toggle"
      },
      "opt+b": {
        "action": "voice.help_toggle"
      },
      "opt+escape": {
        "action": "connections.stop"
      }
    },
    "_platform.pipelines": [
      {
        "name": "command_recognition",
        "trigger": {
          "type": "manual"
        },
        "cancel_delay_ms": 800,
        "stages": [
          {
            "stage": "_platform.mic"
          },
          {
            "stage": "voice.sherpa_commands",
            "params": {
              "model": "sherpa-offline-nemo",
              "lifecycle_mode": "continuous",
              "min-silence": "0.10",
              "dynamic-grammar": "true"
            }
          }
        ],
        "command_collections": [
          "voice_commands"
        ],
        "dispatch": "delegated"
      },
      {
        "name": "dictation",
        "trigger": {
          "type": "manual"
        },
        "cancel_delay_ms": 60000,
        "stop_tail_ms": 200,
        "stages": [
          {
            "stage": "_platform.mic"
          },
          {
            "stage": "_platform.stt",
            "params": {
              "model": "openai_whisper-large-v3-v20240930"
            }
          }
        ],
        "dispatch": "plugin"
      },
      {
        "name": "dictation_sample",
        "trigger": {
          "type": "manual"
        },
        "cancel_delay_ms": 60000,
        "stop_tail_ms": 200,
        "stages": [
          {
            "stage": "_platform.mic"
          },
          {
            "stage": "_platform.stt",
            "params": {
              "model": "openai_whisper-large-v3-v20240930"
            }
          }
        ],
        "dispatch": "plugin"
      }
    ]
  },
  "hud_cards": [
    {
      "channel": "voice.which",
      "description": "Which command? The commands one phrase could mean, each beside a word to say"
    },
    {
      "channel": "voice.blocked",
      "description": "Why a command you said did nothing: this computer can't do it, or the action it runs is gone or changed"
    }
  ],
  "hud_windows": [
    {
      "channel": "main",
      "anchor": "top-right",
      "width": 320,
      "min_height": 100,
      "accepts_input": true,
      "follows_focus": false,
      "description": "Command list overlay"
    },
    {
      "channel": "discovery",
      "anchor": "bottom-right",
      "width": 400,
      "min_height": 400,
      "accepts_input": false,
      "on_pointer": "fade",
      "description": "Discovery/live transcript"
    }
  ],
  "dev": {
    "build": [
      [
        "templ",
        "generate"
      ],
      [
        "go",
        "build",
        "-ldflags=-s -w",
        "-o",
        "../voice-plugin",
        "."
      ]
    ],
    "build_dir": "src"
  },
  "run": "./voice-plugin",
  "action_prefix": "voice",
  "action_types": {
    "dictation": {
      "label": "Dictation",
      "modes": [
        "tap",
        "hold"
      ]
    },
    "command": {
      "label": "Command Capture",
      "modes": [
        "tap",
        "hold"
      ]
    },
    "speak": {
      "label": "Speak Dictation",
      "modes": [
        "tap",
        "hold"
      ]
    },
    "continuous_toggle": {
      "label": "Toggle Continuous Mode",
      "modes": [
        "tap",
        "toggle"
      ]
    },
    "help_toggle": {
      "label": "Toggle Help HUD",
      "modes": [
        "tap",
        "toggle"
      ]
    },
    "wake": {
      "label": "Wake Continuous Listening"
    },
    "retype_last": {
      "label": "Type Last Dictation Again",
      "fields": [
        {
          "key": "form",
          "label": "Form",
          "field_type": "string",
          "required": false,
          "description": "Empty types it as it was typed (repaired and shaped). \"raw\" types what was heard, before corrections and the profile."
        }
      ]
    },
    "rewrite_selection": {
      "label": "Rewrite Selected Text in a Style",
      "fields": [
        {
          "key": "style",
          "label": "Style",
          "field_type": "string",
          "required": true,
          "description": "casual, formal or email: the dictation style to rewrite the selected text in, with the same model and the same checks that names and numbers survive."
        }
      ]
    },
    "dictation_cancel": {
      "label": "Cancel Dictation"
    },
    "sleep": {
      "label": "Sleep Continuous Listening"
    },
    "close_floats": {
      "label": "Close Floating Cards"
    },
    "open_float": {
      "label": "Float Collection Card",
      "fields": [
        {
          "key": "collection",
          "label": "Collection",
          "field_type": "string",
          "required": true
        }
      ]
    },
    "enter_picker": {
      "label": "Enter Open Picker",
      "fields": [
        {
          "key": "mode",
          "label": "Picker",
          "field_type": "string",
          "required": false
        }
      ]
    },
    "repeat": {
      "label": "Repeat Last Command",
      "fields": [
        {
          "key": "count",
          "label": "Repeat Count",
          "placeholder": "1",
          "field_type": "string",
          "required": false
        },
        {
          "key": "mode",
          "label": "Mode",
          "field_type": "string",
          "required": false
        }
      ]
    },
    "pick_tie": {
      "label": "Pick Tie-Break Choice",
      "fields": [
        {
          "key": "choice",
          "label": "Choice",
          "field_type": "string",
          "required": true
        }
      ]
    }
  },
  "default_footer": "Say 'show commands' or press the help key (by default Option+B on a Mac, Alt+B on Linux and Windows) to toggle",
  "hud_targets": [
    "commands",
    "entities",
    "selection",
    "history",
    "dictation"
  ],
  "implements": {
    "pages": [
      {
        "label": "Get started",
        "key": "start",
        "reads": [
          "_platform.model_info",
          "_platform.model_download",
          "_platform.bindings.active"
        ]
      },
      {
        "label": "Command Editor",
        "key": "commands",
        "layout": "workbench",
        "reads": [
          "voice_commands"
        ]
      },
      {
        "label": "Alphabet",
        "key": "phonetics",
        "reads": [
          "voice_commands"
        ]
      },
      {
        "label": "Calibration",
        "key": "calibration",
        "reads": [
          "voice_commands"
        ]
      },
      {
        "label": "Recordings",
        "key": "recordings"
      },
      {
        "label": "Dictation",
        "key": "dictation",
        "reads": [
